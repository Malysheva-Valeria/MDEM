# API конфігурація
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_API_TIMEOUT=30000

# Інформація застосунку
REACT_APP_NAME=Medical AI System
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# Функціональні прапори
REACT_APP_ENABLE_AI_DIAGNOSIS=true
REACT_APP_ENABLE_TELEMEDICINE=true
REACT_APP_ENABLE_VIDEO_CALLS=false

# Ключі зберігання
REACT_APP_TOKEN_KEY=medai_token
REACT_APP_USER_KEY=medai_user