# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mdem
TEST_DATABASE_URL=postgresql://medical_user:medical_password@localhost:5432/medical_test_db

# Security
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Settings
PROJECT_NAME=Medical AI System
VERSION=1.0.0
DEBUG=True
API_V1_STR=/api/v1

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# File Storage
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=10485760